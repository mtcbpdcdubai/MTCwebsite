# Google Apps Script Web App URL used by IdeaSubmissionForm, MediaForm, and
# CustomPartnerShipForm to append rows to a Google Sheet.
VITE_GSHEET_WEBAPP_URL=

# Supabase project (points/leaderboard system). Safe to expose client-side —
# access is enforced by Row Level Security, not by keeping these secret.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
